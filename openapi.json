{
  "openapi": "3.1.0",
  "info": {
    "title": "QSAM chain node API",
    "version": "1.0",
    "description": "Public read API for the 13th Chamber qchain node, plus the transaction submit endpoint. The node runs on a free tier and sleeps when idle, so the first request after a quiet spell can take up to a minute to answer. That is a cold start, not an outage."
  },
  "servers": [
    { "url": "https://qsam-qchain.onrender.com", "description": "Public node (Render free tier)" }
  ],
  "tags": [
    { "name": "chain" },
    { "name": "accounts" },
    { "name": "transactions" }
  ],
  "paths": {
    "/api/status": {
      "get": {
        "tags": ["chain"],
        "operationId": "getStatus",
        "summary": "Chain summary",
        "description": "Height, block and transaction counts, supply per asset, holder counts and peer statistics.",
        "responses": {
          "200": {
            "description": "Chain summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "height": { "type": "integer" },
                    "blocks": { "type": "integer" },
                    "transactions": { "type": "integer" },
                    "assets": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true,
                        "properties": {
                          "asset": { "type": "string" },
                          "symbol": { "type": "string" },
                          "full_name": { "type": "string" },
                          "supply": { "type": "string" },
                          "decimals": { "type": "integer" },
                          "transferable": { "type": "boolean" },
                          "holders": { "type": "integer" }
                        }
                      }
                    },
                    "p2p": {
                      "type": "object",
                      "additionalProperties": true,
                      "properties": {
                        "peers": { "type": "array", "items": { "type": "string" } },
                        "peer_count": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/verify": {
      "get": {
        "tags": ["chain"],
        "operationId": "verifyChain",
        "summary": "Verify the chain",
        "description": "Re-walks every block and returns the validity verdict with any errors found. Use this rather than trusting a height alone.",
        "responses": {
          "200": {
            "description": "Validation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "valid": { "type": "boolean" },
                    "errors": { "type": "array", "items": { "type": "string" } },
                    "height": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/blocks": {
      "get": {
        "tags": ["chain"],
        "operationId": "listBlocks",
        "summary": "List blocks",
        "description": "Block headers in chain order. Useful for paginating an explorer view.",
        "responses": {
          "200": {
            "description": "Blocks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "object", "additionalProperties": true }
                }
              }
            }
          }
        }
      }
    },
    "/api/block/{ref}": {
      "get": {
        "tags": ["chain"],
        "operationId": "getBlock",
        "summary": "Get one block",
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "description": "Block index or block hash.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Block",
            "content": {
              "application/json": {
                "schema": { "type": "object", "additionalProperties": true }
              }
            }
          },
          "404": { "description": "No such block" }
        }
      }
    },
    "/api/mempool": {
      "get": {
        "tags": ["transactions"],
        "operationId": "getMempool",
        "summary": "Pending transactions",
        "description": "Transactions accepted but not yet mined.",
        "responses": {
          "200": {
            "description": "Mempool contents",
            "content": {
              "application/json": {
                "schema": { "type": "object", "additionalProperties": true }
              }
            }
          }
        }
      }
    },
    "/api/address/{address}": {
      "get": {
        "tags": ["accounts"],
        "operationId": "getAddress",
        "summary": "Address balances and history",
        "description": "Balances per asset, the next nonce to use when signing, and the transaction history for the address.",
        "parameters": [
          {
            "name": "address",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Account view",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "address": { "type": "string" },
                    "next_nonce": { "type": "integer" },
                    "transactions": {
                      "type": "array",
                      "items": { "type": "object", "additionalProperties": true }
                    }
                  }
                }
              }
            }
          },
          "404": { "description": "Address not found" }
        }
      }
    },
    "/api/tx": {
      "post": {
        "tags": ["transactions"],
        "operationId": "submitTx",
        "summary": "Submit a signed transaction",
        "description": "The only public write path. Returns 200 with accepted true, or 400 with the rejection reason. Transactions are signed locally with the post-quantum key, so the node never sees a private key.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "required": ["from", "to", "amount", "nonce", "signature"],
                "properties": {
                  "from": { "type": "string" },
                  "to": { "type": "string" },
                  "amount": { "type": "number" },
                  "asset": { "type": "string", "default": "QSAM" },
                  "fee": { "type": "number" },
                  "nonce": { "type": "integer" },
                  "signature": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": { "type": "boolean" },
                    "detail": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Rejected by validation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": { "type": "boolean" },
                    "detail": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
